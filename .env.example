# Space Transfers — customer store
#
# Copy to .env for local work. Vite reads .env in dev and .env.production for
# builds; every VITE_* value is compiled into the bundle and is therefore
# public. Never put a secret here — only publishable keys and URLs.

# The API, including the /api path.
VITE_API_URL=http://localhost:4000/api

# Station 08. The same OAuth client id the API uses as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Station 02. The publishable key (pk_test_… / pk_live_…), never the secret one.
# Card fields do not render without it.
VITE_STRIPE_PUBLISHABLE_KEY=

# Build only: the public address, for robots.txt, sitemap.xml and the
# canonical link. Unset, the sitemap and canonical link are left out.
VITE_SITE_URL=

# Sentry DSN for this app. Unset, nothing is reported.
VITE_SENTRY_DSN=
# How this build's reports are labelled in Sentry: production, or staging for
# the demo. Unset, the build mode.
VITE_SENTRY_ENVIRONMENT=
