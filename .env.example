# Space Transfers — admin console
#
# Copy to .env for local work. Every VITE_* value is compiled into the bundle
# and is therefore public. Never put a secret here.
#
# The admin console has no sign-in with Google and takes no payments.

VITE_API_URL=http://localhost:4000/api

# The customer store, where the legal documents are published. Unset, an
# admin.<domain> address assumes store.<domain>.
VITE_STORE_URL=

# Sentry DSN for this app. Unset, nothing is reported.
VITE_SENTRY_DSN=
# How this build's reports are labelled in Sentry: production, or staging for
# the demo. Unset, the build mode.
VITE_SENTRY_ENVIRONMENT=
