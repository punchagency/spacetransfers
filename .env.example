# Space Transfers — printer portal
#
# Copy to .env for local work. Every VITE_* value is compiled into the bundle
# and is therefore public. Never put a secret here.

VITE_API_URL=http://localhost:4000/api

# Station 08. The same OAuth client id the API uses as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# The customer store, where the Terms, Privacy Policy and Content Policy are
# published. Unset, a printer.<domain> address assumes store.<domain>.
VITE_STORE_URL=

# Sentry DSN for this app. Unset, nothing is reported.
VITE_SENTRY_DSN=
