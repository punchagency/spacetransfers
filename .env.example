# ─────────────────────────────────────────────────────────────────────────────
# Space Transfers — API
#
# Copy to .env and fill in. Station numbers refer to the Go-Live Checklist.
# Anything marked REQUIRED will stop the server or a feature from working.
#
# .env is gitignored and must stay that way. Secrets live in the shared vault
# (station 01), not in email or chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Where each front end is served from. Used to build links in emails, so a
# wrong value sends customers and partners to the wrong place.
APP_URL=http://localhost:5000
PRINTER_APP_URL=http://localhost:5175
# Origin of the admin console. These three URLs form the CORS allowlist — a
# front end deployed to a URL that is not listed here has its browser calls
# refused, with an opaque network error as the only symptom.
ADMIN_APP_URL=http://localhost:5174

# ── Database — station 04 ────────────────────────────────────────────────────
# REQUIRED. Atlas connection string, including the database name.
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Any long random string; changing it signs everyone out.
# Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Station 08. The OAuth client for "Sign in with Google".
GOOGLE_CLIENT_ID=

# ── Artwork storage — station 05 ─────────────────────────────────────────────
# REQUIRED, all five. This is the only artwork store; without them every upload
# fails with a 503 rather than storing somewhere unintended.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=space-transfers

# Where browsers load artwork from: a custom domain bound to the bucket, e.g.
# https://cdn.spacetransfers.com (preferred), or the bucket's public r2.dev URL.
# Not the <account>.r2.cloudflarestorage.com endpoint — that is the S3 API and
# refuses unsigned requests. These URLs are written into the database, so
# changing this later means a migration: pick the final domain before launch.
R2_PUBLIC_BASE_URL=
#
# The bucket also needs a CORS policy (Cloudflare dashboard → R2 → bucket →
# Settings → CORS). The editor reads artwork pixels in the browser for
# auto-crop, background and colour removal, DPI and transparency checks; without
# this every such image fails to load. Allow GET and HEAD from the store, admin
# and printer origins (APP_URL, ADMIN_APP_URL, PRINTER_APP_URL), e.g.
#   [{"AllowedOrigins":["https://spacetransfers.com","https://admin.spacetransfers.com",
#     "https://printer.spacetransfers.com","http://localhost:5000"],
#     "AllowedMethods":["GET","HEAD"],"AllowedHeaders":["*"],"MaxAgeSeconds":86400}]

# ── Payments — station 02 ────────────────────────────────────────────────────
# Test keys (sk_test_…) until go-live. The webhook secret comes from the
# endpoint you register, not from the API keys page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# What a partner must have earned before a payout is drawn. 1000 = $10.00.
MINIMUM_PAYOUT_AMOUNT_CENTS=1000

# ── Email — station 06 ───────────────────────────────────────────────────────
# Email is sent through Resend only.
# Without one, partner invites and password resets are generated and never sent.
# Resend (https://resend.com) — a sending-only key restricted to the domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@spacetransfers.com


# ── Shipping — station 07 ────────────────────────────────────────────────────
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# true buys real postage. ShipStation has no sandbox, so a label is a real
# purchase with no undo — staging and local must leave this false or unset.
# Only the exact string "true" enables it.
SHIPSTATION_LABELS_ENABLED=false

# The carrier that buys postage and the default service, e.g. stamps_com and
# usps_priority_mail.
SHIPSTATION_CARRIER_ID=
SHIPSTATION_SERVICE_CODE=

# HQ warehouse — the fallback for any order with no assigned partner. The id is
# only visible in the warehouse page's URL. Partners with their own warehouse
# override this per order.
SHIPSTATION_WAREHOUSE_ID=
SHIPSTATION_FROM_NAME=
SHIPSTATION_FROM_STREET=
SHIPSTATION_FROM_CITY=
SHIPSTATION_FROM_STATE=
SHIPSTATION_FROM_POSTAL_CODE=
SHIPSTATION_FROM_COUNTRY=US

# Appended as ?token= to the tracking webhook so only ShipStation can call it.
SHIPSTATION_WEBHOOK_SECRET=
SHIPSTATION_POLL_INTERVAL_MS=1800000
SHIPSTATION_MAX_POLLING_DAYS=30

# ── AI — station 09 ──────────────────────────────────────────────────────────
# Gemini is the only image model. Billing must be enabled on the Google Cloud
# project: every Gemini image model has a free-tier limit of zero, so a valid
# key with billing off fails exactly like a rate limit.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Drive export. Leave blank unless it is in use.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Admins must set up a passkey before the console serves them. Leave unset
# (required). "false" is honoured on a developer's machine only.
ADMIN_PASSKEY_REQUIRED=
# Returns the password-reset token in the API response so the flow can be tried
# without a mailbox. Honoured on a developer's machine only; never set it on a
# deployment.
EXPOSE_RESET_TOKENS=
