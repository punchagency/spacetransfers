# ─────────────────────────────────────────────────────────────────────────────
# Space Transfers — API
#
# Copy to .env and fill in. Station numbers refer to the Go-Live Checklist.
# Anything marked REQUIRED will stop the server or a feature from working.
#
# .env is gitignored and must stay that way. Secrets live in the shared vault
# (station 01), not in email or chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Where each front end is served from. Used to build links in emails, so a
# wrong value sends customers and partners to the wrong place.
APP_URL=http://localhost:5000
PRINTER_APP_URL=http://localhost:5175
# Origin of the admin console. These three URLs form the CORS allowlist — a
# front end deployed to a URL that is not listed here has its browser calls
# refused, with an opaque network error as the only symptom.
ADMIN_APP_URL=http://localhost:5174

# ── Database — station 04 ────────────────────────────────────────────────────
# REQUIRED. Atlas connection string, including the database name.
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Any long random string; changing it signs everyone out.
# Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Station 08. The OAuth client for "Sign in with Google".
GOOGLE_CLIENT_ID=

# ── Artwork storage — station 05 ─────────────────────────────────────────────
# REQUIRED, all five. This is the only artwork store; without them every upload
# fails with a 503 rather than storing somewhere unintended.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=space-transfers

# Where browsers load artwork from: a custom domain bound to the bucket, e.g.
# https://cdn.spacetransfers.com (preferred), or the bucket's public r2.dev URL.
# Not the <account>.r2.cloudflarestorage.com endpoint — that is the S3 API and
# refuses unsigned requests. These URLs are written into the database, so
# changing this later means a migration: pick the final domain before launch.
R2_PUBLIC_BASE_URL=
#
# The bucket also needs a CORS policy (Cloudflare dashboard → R2 → bucket →
# Settings → CORS). The editor reads artwork pixels in the browser for
# auto-crop, background and colour removal, DPI and transparency checks; without
# this every such image fails to load. Allow GET and HEAD from the store, admin
# and printer origins (APP_URL, ADMIN_APP_URL, PRINTER_APP_URL), e.g.
#   [{"AllowedOrigins":["https://spacetransfers.com","https://admin.spacetransfers.com",
#     "https://printer.spacetransfers.com","http://localhost:5000"],
#     "AllowedMethods":["GET","HEAD"],"AllowedHeaders":["*"],"MaxAgeSeconds":86400}]

# ── Payments — station 02 ────────────────────────────────────────────────────
# Test keys (sk_test_…) until go-live. The webhook secret comes from the
# endpoint you register, not from the API keys page:
# `node scripts/setup-stripe-webhook.mjs https://your-api-address` registers it
# and prints the secret once.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# What a partner must have earned before a payout is drawn. 1000 = $10.00.
MINIMUM_PAYOUT_AMOUNT_CENTS=1000

# ── Email — station 06 ───────────────────────────────────────────────────────
# Email is sent through Resend only.
# Without one, partner invites and password resets are generated and never sent.
# Resend (https://resend.com) — a sending-only key restricted to the domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@spacetransfers.com


# ── Shipping — station 07 ────────────────────────────────────────────────────
# Rates, labels and tracking through EasyPost (https://www.easypost.com). The
# API key is under Account Settings → API Keys; test and production keys differ.
# Without a key, checkout charges the flat shipping rates from the admin console.
# The key also checks each customer's address with the carrier at checkout
# (EasyPost may bill a cent or so per check); without it, addresses aren't checked.
EASYPOST_API_KEY=

# true lets this environment buy labels. With a test key they are free test
# labels; with a production key they are real postage. Staging that holds a
# production key must leave this false or unset. Only "true" enables it.
EASYPOST_LABELS_ENABLED=false

# Optional: quote and buy only from these carriers (comma-separated, as EasyPost
# names them, e.g. USPS,UPS), or only on these carrier accounts (ca_...).
# Blank uses every carrier on the account. `node scripts/test-easypost.mjs`
# lists what the account offers.
EASYPOST_CARRIERS=
EASYPOST_CARRIER_ACCOUNTS=

# Signs EasyPost's webhook events. Any long random string; register it with
# `node scripts/setup-easypost-webhook.mjs https://your-api-address`.
EASYPOST_WEBHOOK_SECRET=

# Where shipping is quoted from when no partner serves the customer's region.
# Only the ZIP, city and state matter. Never printed on a label: labels ship
# from the partner's business address. SHIP_FROM_PHONE is the contact number a
# label carries when the partner has none on record.
SHIP_FROM_NAME=
SHIP_FROM_STREET=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=

# How often parcels are checked with the carrier as a backup to the webhook,
# and for how many days after ordering.
TRACKING_POLL_INTERVAL_MS=1800000
TRACKING_MAX_POLLING_DAYS=30

# ── AI — station 09 ──────────────────────────────────────────────────────────
# Gemini is the only image model. Billing must be enabled on the Google Cloud
# project: every Gemini image model has a free-tier limit of zero, so a valid
# key with billing off fails exactly like a rate limit.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Google Drive export. Leave blank unless it is in use.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Admins must set up a passkey before the console serves them. Leave unset
# (required). "false" is honoured on a developer's machine only.
ADMIN_PASSKEY_REQUIRED=
# Returns the password-reset token in the API response so the flow can be tried
# without a mailbox. Honoured on a developer's machine only; never set it on a
# deployment.
EXPOSE_RESET_TOKENS=

# ── Backups ──────────────────────────────────────────────────────────────────
# Nightly encrypted copies of the database in R2 (03:00 UTC, last 30 kept).
# Generate the key with:  openssl rand -hex 32
# Keep a copy of the key somewhere other than this server: without it the
# backups cannot be read.
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
# Optional: a separate, private bucket for backups. Defaults to R2_BUCKET.
BACKUP_R2_BUCKET=

# ── Print exports ────────────────────────────────────────────────────────────
# How many print-size exports may render at once. Each can need about 2 GB (a
# 100in part of a dense sheet at 300 DPI); more wait their turn. Size it to the
# server's memory: 1 on a 4 GB instance. Unset, 3.
EXPORT_RENDER_CONCURRENCY=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Sentry project DSN. Unset, no errors are reported anywhere.
SENTRY_DSN=
# How this deployment's reports are labelled in Sentry: production, or staging
# for the demo. Unset, NODE_ENV.
SENTRY_ENVIRONMENT=
